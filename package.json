{
  "name": "@w2112515/dsh-remote-host",
  "version": "0.2.2",
  "description": "One DSH Remote Host bundle: Noise projection, commands, prompt/stop admissions, pairing settings. Linux and Windows.",
  "type": "module",
  "license": "MIT",
  "homepage": "https://github.com/w2112515/dsh-remote-host#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/w2112515/dsh-remote-host.git"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "exports": {
    "./control": "./runtime/control/index.js",
    "./command": "./runtime/command/index.js",
    "./remote": "./runtime/remote/index.js",
    "./admissions": "./runtime/admissions/index.js",
    "./settings": "./runtime/settings/index.js",
    "./client": "./runtime/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "dsh-remote-host-setup": "./scripts/setup.mjs"
  },
  "files": [
    "cordis.patch.yml",
    "README.md",
    "README.zh-CN.md",
    "llms.txt",
    "contrib",
    "scripts/invite.mjs",
    "scripts/setup.mjs",
    "scripts/setup.sh",
    "scripts/setup.ps1",
    "scripts/start.sh",
    "scripts/start.ps1",
    "scripts/env.sh",
    "scripts/env.ps1",
    "scripts/link-dsh-deps.sh",
    "scripts/link-dsh-deps.ps1",
    "runtime",
    "native"
  ],
  "scripts": {
    "pack-runtime": "node scripts/pack-runtime.mjs",
    "setup": "node scripts/setup.mjs",
    "invite": "node scripts/invite.mjs"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@grpc/grpc-js": "1.14.4",
    "@grpc/proto-loader": "0.8.1",
    "@homebridge/ciao": "1.3.10",
    "qrcode": "^1.5.4",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "esbuild": "^0.28.2"
  }
}
